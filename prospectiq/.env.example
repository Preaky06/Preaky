# Pro Spectre — variables d'environnement. Copier en .env.local (local) ou les saisir dans Vercel (production).
# Toutes sont lues côté serveur uniquement : aucune n'est exposée au navigateur.

# --- Obligatoire en production -------------------------------------------------
APP_URL=https://votre-domaine.fr
# PostgreSQL (Neon, Supabase…). Sans cette variable, base locale PGlite dans .data/ (développement uniquement).
# Supabase : utiliser l'URL du pooler en mode transaction (port 6543).
DATABASE_URL=
# Comptes administrateurs (séparés par des virgules) : accès à /admin
ADMIN_EMAILS=vous@votre-domaine.fr
# Secret de la tâche quotidienne de purge (Vercel l'envoie automatiquement si la variable existe). Générer : openssl rand -hex 32
CRON_SECRET=

# --- Mentions légales (affichées sur /mentions-legales ; « à compléter » sinon) --
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_VAT=
LEGAL_DIRECTOR=
LEGAL_EMAIL=
# LEGAL_HOST=Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis
LEGAL_DB_HOST=

# --- Paiement Stripe (sans ces 5 variables, la souscription est désactivée et affichée comme telle)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- E-mails (mot de passe oublié, invitations). Sans SMTP, les e-mails sont stockés dans la table outbox
# et les liens d'invitation sont affichés au propriétaire. Exemple Brevo : smtp://identifiant:cle@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=Pro Spectre <no-reply@votre-domaine.fr>

# --- Facultatif : IA (tout fournisseur compatible Chat Completions : Mistral, OpenAI, Groq…)
# Sans IA, analyses et messages sont rédigés par modèles déterministes à partir des mêmes faits.
AI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=
# Prix en euros par million de jetons, pour le suivi des coûts dans /admin
AI_PRICE_INPUT_EUR_PER_MTOK=0
AI_PRICE_OUTPUT_EUR_PER_MTOK=0

# --- Facultatif : Google Places API (New) — note et avis Google (API payante au-delà du quota gratuit)
GOOGLE_PLACES_API_KEY=

# --- Avancé (valeurs par défaut correctes) ---------------------------------------
# SESSION_DAYS=30
# SIRENE_API_URL=https://recherche-entreprises.api.gouv.fr
# BODACC_API_URL=https://bodacc-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/annonces-commerciales
# GEO_API_URL=https://geo.api.gouv.fr
# PGLITE_DIR=.data/pglite
