# Copiez ce fichier en .env puis renseignez au minimum la clé API et les
# informations légales (affichées sur /mentions-legales et /confidentialite).

# --- Obligatoire -----------------------------------------------------------
# Clé API Anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Informations légales (obligatoires en France pour un site public) -----
OWNER_NAME=Prénom Nom                     # ou raison sociale
OWNER_STATUS=Particulier                  # ex. « Micro-entreprise — SIRET 123 456 789 00012 »
OWNER_ADDRESS=1 rue Exemple, 75000 Paris
OWNER_EMAIL=contact@exemple.fr            # affiché aussi pour « Signaler un problème »
# PUBLICATION_DIRECTOR=Prénom Nom         # par défaut : OWNER_NAME
HOSTING_PROVIDER=Render Services, Inc. — 525 Brannan Street, Suite 300, San Francisco, CA 94107, États-Unis

# --- Hébergement avec docker compose ---------------------------------------
DOMAIN=explisite.fr                       # votre nom de domaine (HTTPS automatique)

# --- Comptes et documents enregistrés --------------------------------------
# DATA_DIR=./data                         # base de données + clé de chiffrement (volume persistant !)
# ENCRYPTION_KEY=                         # 64 caractères hexadécimaux ; sinon générée dans DATA_DIR
#                                         #   (openssl rand -hex 32). Perdue = documents illisibles.
# ACCOUNTS=1                              # 0 pour désactiver les comptes
# ALLOW_SIGNUP=1                          # 0 pour fermer les inscriptions
# MAX_DOCS_PER_USER=300

# --- Abonnement ExpliSite+ (Stripe, optionnel) -------------------------------
# Tableau de bord Stripe → Produits : créez « ExpliSite+ » avec un prix mensuel et un
# prix annuel, copiez leurs identifiants (price_…). Webhook : https://VOTRE-DOMAINE/api/billing/webhook
# avec les événements checkout.session.completed et customer.subscription.*
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# FREE_ANALYSES_PER_MONTH=1
# FREE_QUESTIONS_PER_DOCUMENT=5             # questions au chat par analyse (gratuit)
# PREMIUM_QUESTIONS_PER_DOCUMENT=20         # questions au chat par analyse (abonnés)
# FREE_QUESTIONS_PER_MONTH=10               # plafond mensuel de sécurité
# PREMIUM_QUESTIONS_PER_MONTH=400
# PREMIUM_ANALYSES_PER_MONTH=200            # usage raisonnable des abonnés

# --- Connexion avec Google (optionnel) --------------------------------------
# Créez un « ID client OAuth » de type « Application Web » sur
# https://console.cloud.google.com/apis/credentials et déclarez l'URI de redirection :
#   https://VOTRE-DOMAINE/api/auth/google/callback
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Site ------------------------------------------------------------------
PORT=3000
# SITE_URL=https://explisite.example.fr     # URL publique (liens de partage, sitemap, HSTS)
# TRUST_PROXY=1                           # derrière un reverse proxy (Render, Railway, Nginx…)

# --- Réglages de l'IA (optionnel) ------------------------------------------
# EXPLISITE_MODEL=claude-sonnet-5        # claude-opus-5 : meilleure qualité, 2 à 3 fois plus cher
# EXPLISITE_EFFORT=high                     # low | medium | high | xhigh | max
# EXPLISITE_CHAT_EFFORT=medium
# EXPLISITE_FALLBACKS=                    # auto (actif avec Opus 5) ; 1 = forcer, 0 = couper

# --- Protection (optionnel) ------------------------------------------------
# RATE_LIMIT_PER_HOUR=40                  # appels max par IP et par heure
# DAILY_LIMIT=1000                        # appels max par jour, tous visiteurs confondus
# MAX_UPLOAD_MB=24

# DEMO_MODE=1                             # force le mode démo (résultats fictifs, aucun appel API)
