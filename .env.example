# Copiez ce fichier en .env puis renseignez votre clé.
# Clé API Anthropic : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port d'écoute (la plupart des hébergeurs le fournissent automatiquement)
PORT=3000

# Optionnel
# LIMPIDE_MODEL=claude-opus-5        # modèle utilisé
# LIMPIDE_EFFORT=high                # profondeur de l'analyse : low | medium | high | xhigh | max
# LIMPIDE_CHAT_EFFORT=medium         # profondeur des réponses du chat
# LIMPIDE_FALLBACKS=1                # 0 pour désactiver le repli automatique en cas de refus
# RATE_LIMIT_PER_HOUR=40             # requêtes max par IP et par heure
# MAX_UPLOAD_MB=24                   # taille max d'une requête
# TRUST_PROXY=1                      # à activer derrière un reverse proxy (Render, Railway, Nginx…)
# DEMO_MODE=1                        # force le mode démo (résultats fictifs, aucun appel API)
