{
  "name": "sneaky",
  "version": "1.0.0",
  "description": "Sneaky — quiz d'infiltration en présentiel, chacun sur son téléphone.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n serveur,client -c yellow,cyan \"tsx watch server/index.ts\" \"vite --host\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
