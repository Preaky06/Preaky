# URL publique de l'application (sans slash final)
APP_URL=http://localhost:3000

# Secret de signature des sessions : openssl rand -hex 32
SESSION_SECRET=

# Application Discord (https://discord.com/developers/applications)
# Redirect URI à déclarer : ${APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optionnel : token du bot pour attribuer le rôle Discord à l'acceptation
# (le bot doit avoir la permission "Gérer les rôles" et un rôle au-dessus du rôle attribué)
DISCORD_BOT_TOKEN=

# Base de données : fichier local par défaut, ou Turso en production
# DATABASE_URL=libsql://xxx.turso.io
# DATABASE_AUTH_TOKEN=

# Connexion sans Discord pour le développement local. Ignoré en production.
DEV_LOGIN=1
